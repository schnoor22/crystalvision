{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(?:www\\.)?crystalvisionusa\\.com" }],
      "destination": "https://www.firstlightclean.com/:path*",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" }
  ]
}
